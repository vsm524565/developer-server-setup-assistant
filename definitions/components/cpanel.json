{
  "schema_version": "1.0",
  "id": "cpanel",
  "display_name": "cPanel & WHM",
  "description": "Licensed hosting control panel (cPanel and WHM). Takes over the whole server.",
  "category": "control_panel",
  "depends_on": [],
  "variants": [
    {
      "variant_id": "apt-vendor-installer",
      "support": "draft",
      "platform": {
        "package_manager": "apt",
        "os": [
          {
            "id": "ubuntu",
            "versions": [
              "24.04"
            ]
          }
        ],
        "architectures": [
          "x86_64"
        ]
      },
      "detection": {
        "packages_all": [],
        "state": "panel_present",
        "panel": "cpanel"
      },
      "conflicts": {
        "tcp_ports": [
          80,
          443
        ]
      },
      "steps": [
        {
          "type": "vendor_installer",
          "url": "https://securedownloads.cpanel.net/latest",
          "workdir": "/home"
        }
      ],
      "verification": [
        {
          "type": "hook",
          "name": "verify_panel_cpanel"
        },
        {
          "type": "tcp_listening",
          "port": 2087
        }
      ],
      "rollback": {
        "created_paths": []
      },
      "hooks": {
        "verify": "verify_panel_cpanel"
      },
      "requirements": {
        "fresh_server": true,
        "conflicting_packages": [
          "nginx",
          "apache2",
          "mariadb-server",
          "mysql-server",
          "postgresql",
          "postfix",
          "exim4",
          "dovecot-core",
          "bind9"
        ],
        "min_ram_mb": 2048,
        "min_disk_mb": 25600,
        "fqdn_hostname": true
      }
    },
    {
      "variant_id": "dnf-vendor-installer",
      "support": "draft",
      "platform": {
        "package_manager": "dnf",
        "os": [
          {
            "id": "almalinux",
            "versions": [
              "9",
              "10"
            ]
          }
        ],
        "architectures": [
          "x86_64"
        ]
      },
      "detection": {
        "packages_all": [],
        "state": "panel_present",
        "panel": "cpanel"
      },
      "conflicts": {
        "tcp_ports": [
          80,
          443
        ]
      },
      "steps": [
        {
          "type": "vendor_installer",
          "url": "https://securedownloads.cpanel.net/latest",
          "workdir": "/home"
        }
      ],
      "verification": [
        {
          "type": "hook",
          "name": "verify_panel_cpanel"
        },
        {
          "type": "tcp_listening",
          "port": 2087
        }
      ],
      "rollback": {
        "created_paths": []
      },
      "hooks": {
        "verify": "verify_panel_cpanel"
      },
      "requirements": {
        "fresh_server": true,
        "conflicting_packages": [
          "nginx",
          "httpd",
          "mariadb-server",
          "mysql-server",
          "mysql8.4-server",
          "postgresql-server",
          "dovecot",
          "bind"
        ],
        "min_ram_mb": 2048,
        "min_disk_mb": 25600,
        "fqdn_hostname": true
      }
    }
  ]
}
