{
  "schema_version": "1.0",
  "id": "nginx",
  "display_name": "Nginx",
  "category": "webserver",
  "depends_on": [],
  "variants": [
    {
      "variant_id": "apt-os-repository",
      "support": "draft",
      "platform": {
        "package_manager": "apt"
      },
      "detection": {
        "packages_all": [
          "nginx"
        ]
      },
      "conflicts": {
        "unmanaged_executables": [
          "nginx"
        ],
        "paths": [
          "/etc/nginx",
          "/usr/local/nginx"
        ],
        "tcp_ports": [
          80,
          443
        ],
        "panels": "any"
      },
      "steps": [
        {
          "type": "package_metadata_refresh"
        },
        {
          "type": "packages_install",
          "role": "main",
          "packages": [
            "nginx"
          ]
        },
        {
          "type": "managed_file",
          "path": "/etc/nginx/conf.d/dssa-hardening.conf",
          "template": "nginx/hardening.conf",
          "mode": "0644",
          "owner": "root:root"
        },
        {
          "type": "service_enable",
          "unit": "nginx.service"
        },
        {
          "type": "service_start",
          "unit": "nginx.service"
        },
        {
          "type": "service_reload",
          "unit": "nginx.service",
          "config_test": "nginx -t"
        }
      ],
      "verification": [
        {
          "type": "packages_installed",
          "packages": [
            "nginx"
          ]
        },
        {
          "type": "config_test",
          "command": "nginx -t"
        },
        {
          "type": "service_active",
          "unit": "nginx.service"
        },
        {
          "type": "tcp_listening",
          "port": 80
        },
        {
          "type": "executable",
          "name": "nginx",
          "version_args": [
            "-v"
          ],
          "version_pattern": "^nginx version: nginx/[0-9]+"
        }
      ],
      "rollback": {
        "created_paths": [
          "/etc/nginx",
          "/var/log/nginx",
          "/var/www/html"
        ]
      }
    },
    {
      "variant_id": "dnf-os-repository",
      "support": "draft",
      "platform": {
        "package_manager": "dnf"
      },
      "detection": {
        "packages_all": [
          "nginx"
        ]
      },
      "conflicts": {
        "unmanaged_executables": [
          "nginx"
        ],
        "paths": [
          "/etc/nginx",
          "/usr/local/nginx"
        ],
        "tcp_ports": [
          80,
          443
        ],
        "panels": "any"
      },
      "steps": [
        {
          "type": "packages_install",
          "role": "main",
          "packages": [
            "nginx"
          ]
        },
        {
          "type": "managed_file",
          "path": "/etc/nginx/conf.d/dssa-hardening.conf",
          "template": "nginx/hardening.conf",
          "mode": "0644",
          "owner": "root:root"
        },
        {
          "type": "service_enable",
          "unit": "nginx.service"
        },
        {
          "type": "service_start",
          "unit": "nginx.service"
        },
        {
          "type": "service_reload",
          "unit": "nginx.service",
          "config_test": "nginx -t"
        }
      ],
      "verification": [
        {
          "type": "packages_installed",
          "packages": [
            "nginx"
          ]
        },
        {
          "type": "config_test",
          "command": "nginx -t"
        },
        {
          "type": "service_active",
          "unit": "nginx.service"
        },
        {
          "type": "tcp_listening",
          "port": 80
        },
        {
          "type": "executable",
          "name": "nginx",
          "version_args": [
            "-v"
          ],
          "version_pattern": "^nginx version: nginx/[0-9]+"
        }
      ],
      "rollback": {
        "created_paths": [
          "/etc/nginx",
          "/var/log/nginx",
          "/usr/share/nginx"
        ]
      }
    }
  ]
}
