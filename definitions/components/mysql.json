{
  "schema_version": "1.0",
  "id": "mysql",
  "display_name": "MySQL",
  "category": "database",
  "depends_on": [],
  "variants": [
    {
      "variant_id": "apt-ubuntu",
      "support": "draft",
      "platform": {
        "package_manager": "apt",
        "os": [
          {
            "id": "ubuntu",
            "versions": [
              "22.04",
              "24.04",
              "26.04"
            ]
          }
        ]
      },
      "detection": {
        "packages_all": [
          "mysql-server"
        ]
      },
      "conflicts": {
        "packages": [
          "mariadb-server"
        ],
        "paths": [
          "/var/lib/mysql"
        ],
        "tcp_ports": [
          3306
        ],
        "panels": "any"
      },
      "steps": [
        {
          "type": "package_metadata_refresh"
        },
        {
          "type": "packages_install",
          "role": "main",
          "packages": [
            "mysql-server"
          ]
        },
        {
          "type": "service_enable",
          "unit": "mysql.service"
        },
        {
          "type": "service_start",
          "unit": "mysql.service"
        }
      ],
      "verification": [
        {
          "type": "packages_installed",
          "packages": [
            "mysql-server"
          ]
        },
        {
          "type": "service_active",
          "unit": "mysql.service"
        },
        {
          "type": "tcp_listening",
          "port": 3306
        },
        {
          "type": "executable",
          "name": "mysql",
          "version_args": [
            "--version"
          ],
          "version_pattern": "^mysql +Ver [0-9]+"
        }
      ],
      "rollback": {
        "created_paths": [
          "/var/lib/mysql",
          "/etc/mysql"
        ]
      }
    },
    {
      "variant_id": "dnf-os-repository",
      "support": "draft",
      "platform": {
        "package_manager": "dnf"
      },
      "detection": {
        "packages_all": [
          "mysql8.4-server"
        ]
      },
      "conflicts": {
        "packages": [
          "mariadb-server"
        ],
        "paths": [
          "/var/lib/mysql"
        ],
        "tcp_ports": [
          3306
        ],
        "panels": "any"
      },
      "steps": [
        {
          "type": "packages_install",
          "role": "main",
          "packages": [
            "mysql8.4-server"
          ]
        },
        {
          "type": "service_enable",
          "unit": "mysqld.service"
        },
        {
          "type": "service_start",
          "unit": "mysqld.service"
        }
      ],
      "verification": [
        {
          "type": "packages_installed",
          "packages": [
            "mysql8.4-server"
          ]
        },
        {
          "type": "service_active",
          "unit": "mysqld.service"
        },
        {
          "type": "tcp_listening",
          "port": 3306
        },
        {
          "type": "executable",
          "name": "mysql",
          "version_args": [
            "--version"
          ],
          "version_pattern": "^mysql +Ver [0-9]+"
        }
      ],
      "rollback": {
        "created_paths": [
          "/var/lib/mysql",
          "/var/log/mysql"
        ]
      }
    }
  ]
}
