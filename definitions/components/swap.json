        "paths": [
          "/swapfile.dssa"
        ]
      },
      "steps": [
        {
          "type": "swap_file",
          "path": "/swapfile.dssa"
        }
      ],
      "verification": [
        {
          "type": "hook",
          "name": "verify_swap_active"
        }
      ],
      "rollback": {
