{
  "schema_version": "1.0",
  "id": "cloudpanel",
  "display_name": "CloudPanel",
  "description": "Free control panel for PHP, Node.js and Python sites. Takes over the whole server.",
  "category": "control_panel",
  "depends_on": [],
  "variants": [
    {
      "variant_id": "apt-vendor-installer",
      "support": "draft",
      "platform": {
        "package_manager": "apt",
        "os": [
          {
            "id": "ubuntu",
            "versions": [
              "22.04",
              "24.04",
              "26.04"
            ]
          },
          {
            "id": "debian",
            "versions": [
              "12",
              "13"
            ]
          }
        ],
        "architectures": [
          "x86_64"
        ]
      },
      "detection": {
        "packages_all": [],
        "state": "panel_present",
        "panel": "cloudpanel"
      },
      "conflicts": {
        "tcp_ports": [
          80,
          443
        ]
      },
      "steps": [
        {
          "type": "vendor_installer",
          "url": "https://installer.cloudpanel.io/ce/v2/install.sh",
          "env": {
            "DB_ENGINE": "MARIADB_11.8"
          }
        }
      ],
      "verification": [
        {
          "type": "hook",
          "name": "verify_panel_cloudpanel"
        },
        {
          "type": "tcp_listening",
          "port": 8443
        }
      ],
      "rollback": {
        "created_paths": []
      },
      "hooks": {
        "verify": "verify_panel_cloudpanel"
      },
      "requirements": {
        "fresh_server": true,
        "conflicting_packages": [
          "nginx",
          "apache2",
          "mariadb-server",
          "mysql-server",
          "postgresql",
          "postfix",
          "exim4",
          "dovecot-core",
          "bind9"
        ],
        "min_ram_mb": 2048,
        "min_disk_mb": 10240
      }
    }
  ]
}
